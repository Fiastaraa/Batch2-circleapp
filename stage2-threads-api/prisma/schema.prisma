generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique @db.VarChar(100)
  full_name     String    @db.VarChar(150)
  email         String    @unique @db.VarChar(150)
  password      String    @db.VarChar(255)
  photo_profile String?   @db.VarChar(255)
  bio           String?   @db.VarChar(500)
  created_at    DateTime  @default(now())
  created_by    Int?
  updated_at    DateTime  @default(now()) @updatedAt
  updated_by    Int?

  creator       User?     @relation("UserCreator", fields: [created_by], references: [id])
  updater       User?     @relation("UserUpdater", fields: [updated_by], references: [id])
  createdUsers  User[]    @relation("UserCreator")
  updatedUsers  User[]    @relation("UserUpdater")

  threads           Thread[]    @relation("ThreadCreator")
  updatedThreads    Thread[]    @relation("ThreadUpdater")
  replies           Reply[]     @relation("ReplyUser")
  createdReplies    Reply[]     @relation("ReplyCreator")
  updatedReplies    Reply[]     @relation("ReplyUpdater")
  likes             Like[]      @relation("LikeUser")
  createdLikes      Like[]      @relation("LikeCreator")
  updatedLikes      Like[]      @relation("LikeUpdater")
  following         Following[] @relation("FollowingUser")
  followers         Following[] @relation("FollowerUser")

  @@map("users")
}

model Following {
  id           Int      @id @default(autoincrement())
  following_id Int
  follower_id  Int
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  following    User     @relation("FollowingUser", fields: [following_id], references: [id], onDelete: Cascade)
  follower     User     @relation("FollowerUser", fields: [follower_id], references: [id], onDelete: Cascade)

  @@map("following")
}

model Thread {
  id                Int      @id @default(autoincrement())
  content           String   @db.VarChar(500)
  image             String?  @db.VarChar(255)
  number_of_replies Int      @default(0)
  created_at        DateTime @default(now())
  created_by        Int?
  updated_at        DateTime @default(now()) @updatedAt
  updated_by        Int?

  creator           User?    @relation("ThreadCreator", fields: [created_by], references: [id], onDelete: SetNull)
  updater           User?    @relation("ThreadUpdater", fields: [updated_by], references: [id], onDelete: SetNull)
  replies           Reply[]
  likes             Like[]

  @@map("threads")
}

model Reply {
  id         Int      @id @default(autoincrement())
  user_id    Int
  thread_id  Int
  image      String?  @db.VarChar(255)
  content    String   @db.VarChar(500)
  created_at DateTime @default(now())
  created_by Int?
  updated_at DateTime @default(now()) @updatedAt
  updated_by Int?

  user       User     @relation("ReplyUser", fields: [user_id], references: [id], onDelete: Cascade)
  thread     Thread   @relation(fields: [thread_id], references: [id], onDelete: Cascade)
  creator    User?    @relation("ReplyCreator", fields: [created_by], references: [id], onDelete: SetNull)
  updater    User?    @relation("ReplyUpdater", fields: [updated_by], references: [id], onDelete: SetNull)

  @@map("replies")
}

model Like {
  id         Int      @id @default(autoincrement())
  user_id    Int
  thread_id  Int
  created_at DateTime @default(now())
  created_by Int?
  updated_at DateTime @default(now()) @updatedAt
  updated_by Int?

  user       User     @relation("LikeUser", fields: [user_id], references: [id], onDelete: Cascade)
  thread     Thread   @relation(fields: [thread_id], references: [id], onDelete: Cascade)
  creator    User?    @relation("LikeCreator", fields: [created_by], references: [id], onDelete: SetNull)
  updater    User?    @relation("LikeUpdater", fields: [updated_by], references: [id], onDelete: SetNull)

  @@unique([user_id, thread_id])
  @@map("likes")
}
